{
  "name": "loyalty-events-api",
  "version": "1.0.0",
  "description": "Ingestão de eventos de fidelidade com idempotência em três camadas (NestJS + MongoDB + Redis/Bull)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "npm test && npm run test:integration",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.0",
    "bull": "^4.16.5",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.8",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@testcontainers/mongodb": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
